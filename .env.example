# Django 核心配置
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置（开发默认 SQLite，生产切换为 mysql）
# DB_ENGINE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=ops_manager
# DB_USER=root
# DB_PASSWORD=your-db-password

# Redis 配置（Celery 任务队列使用）
REDIS_URL=redis://127.0.0.1:6379/0

# 任务执行后端：thread（默认，无需 Redis）/ celery（生产，需 worker）/ sync（同步，测试）
TASK_EXEC_BACKEND=thread

# Ansible 集中管理项目目录（平台方法 ansible_playbook provider 在此目录执行剧本）
ANSIBLE_PROJECT_DIR=/path/to/your/ansible-project
# 默认 inventory（相对项目目录或绝对路径，留空则用项目 ansible.cfg）
ANSIBLE_INVENTORY=

# JWT 配置（单位：分钟/天）
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# 跨域配置
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
