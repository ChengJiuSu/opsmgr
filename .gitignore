# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Django 运行数据
db.sqlite3
db.sqlite3.*
logs/
*.log

# 前端
frontend/node_modules/
frontend/dist/

# collectstatic 产物（部署时生成，不入库）
staticfiles/

# IDE / 编辑器
.idea/
.vscode/
*.swp

# 环境变量（敏感配置不入库）。.env.* 一并排除是为了盖住 .env.bak_* 这类备份名；
# 例外是 .env.example —— 模板不含真实值，必须入库，否则别人 clone 下来
# 不知道要配哪些变量。
.env
.env.*
!.env.example

# 构建制品落盘目录（ARTIFACT_ROOT 默认 media/artifacts）
media/

# CI 打包产物目录（Makefile build 目标输出，共享库据此生成 md5 与 tar 包）
output/

# 依赖 wheelhouse（Makefile wheels 目标生成，随 output/ 一起打包，不入库）
wheelhouse/

# CI 侧构建 venv（shebang 指向容器内路径，只在构建容器里可用）
.ci-venv/

# 容器化 nginx（deploy/nginx/）：配置入库，运行态产物不入库。
# certs 里是 TLS 私钥，logs 是几 MB 且含客户端 IP 的访问日志，.backup 是改配置
# 时自动留的历史副本——三者都别让 `git add -A deploy` 顺手带进历史。
# .env 由上面的 .env / .env.* 规则覆盖（含 .env.bak_* 这类备份名）。
deploy/nginx/certs/
deploy/nginx/logs/
deploy/nginx/**/.backup/

# Cython 编译产物：deploy/cython/build.py 在本地验证（make cython-check）时
# 会就地生成 .so / .c 与 setuptools 的 build/。镜像里的那份由 Dockerfile 的
# builder 阶段产出，两边都不该入库。
*.so
*.c
/build/

# 内置 MySQL 的 root 密码等（deploy/docker/mysql.env.example 是模板）。
# 上面的 .env / .env.* 规则匹配不到这个文件名，必须单列。
deploy/docker/mysql.env
