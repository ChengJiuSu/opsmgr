# 生产环境变量模板：复制到项目根目录为 .env 并按实际环境修改
#   cp deploy/env.example /opt/devops-manager/.env
#
# ⚠ DJANGO_SETTINGS_MODULE 写在 .env 里【不生效】（decouple 不导出进程环境变量）。
#   生产 settings 的生效途径：
#     - gunicorn 走 ops_manager/wsgi.py：不设该变量时默认即 prod
#     - supervisor：deploy/ops-manager.conf 等托管配置已显式注入
#   本地 manage.py 命令需要 prod 时显式带前缀：
#     DJANGO_SETTINGS_MODULE=ops_manager.settings.prod venv/bin/python manage.py migrate

# ── Django 核心 ──────────────────────────────────────────
# 随机长字符串，可用 `python -c "import secrets; print(secrets.token_urlsafe(50))"` 生成
SECRET_KEY=change-me
# 逗号分隔，填服务器 IP / 域名
ALLOWED_HOSTS=127.0.0.1,192.168.1.100

# 平台对外基础地址：拼接制品带签名下载 URL（CD 目标主机经此拉包），必配
SITE_BASE_URL=http://192.168.1.100

# ⚠⚠ 库内秘密的统一加密密钥。**首次上线必须在 migrate 之前配好**。
# 加密对象：连接凭据的密码/私钥/提权密码、云账号 AccessKey Secret、证书私钥、
#          敏感执行变量、MFA 的 TOTP 密钥 —— 这些都必须能还原（要建 SSH 连接、
#          调厂商 API、注入 ansible），所以不能只存哈希。
# 留空会回退用 SECRET_KEY 派生：那样将来轮换 SECRET_KEY 会让上述数据【全部解不开】
#          （表现为 SSH 认证失败、MFA 校验失败、任务执行报变量解密失败）。
# 它不是调用方的 API Key —— 那是「系统管理 → API 凭证」签发的 ak_xxx.yyy，
#          只存哈希、每个调用方一把，与这里无关。
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_ENC_KEY=change-me-and-never-rotate-casually

# 制品下载 URL 的签名密钥（Artifact.download_sig）。留空回退 SECRET_ENC_KEY。
# 换掉会让【已签发但还没用掉】的下载 URL 失效 —— 这些 URL 执行时现算现用，
# 影响面只限于换 key 那一刻正在跑的 CD。单独配可让它与其他秘密分开轮换。
# ARTIFACT_SIGN_KEY=

# ── 机读接口访问控制（API 凭证）──────────────────────────
# 本服务前置的反向代理地址（CIDR 或单 IP，逗号分隔）。
# ⚠ API 凭证的 IP 白名单只信这些地址转发来的 X-Forwarded-For；**多层代理必须把
#   每一层都写进来**（nginx、SLB、WAF），否则会把内层代理 IP 当成客户端，
#   导致所有白名单失配（fail-closed，表现是一律 403，报错里带实际观测到的 IP）。
# 默认只含回环：单机 nginx 反代（proxy_pass 到 127.0.0.1）即可工作。
TRUSTED_PROXIES=127.0.0.1,::1
# 单把凭证的默认限速（DRF 速率语法），凭证上可单独覆盖
# API_KEY_DEFAULT_RATE=60/min
# 凭证校验失败的锁定策略（按 key_id 计数，防拿到 key_id 后暴力猜 secret）
# API_KEY_FAIL_LIMIT=20
# API_KEY_FAIL_WINDOW=300
# API_KEY_FAIL_BLOCK=300
# 凭证「最近使用」写库的最小间隔（秒）：每请求一次 UPDATE 会把机读接口的写压力翻倍
# API_KEY_TOUCH_INTERVAL=60

# ── 数据库（MySQL，prod 配置使用；dev 配置固定 SQLite 不读这些）──
DB_NAME=ops_manager
DB_USER=ops
DB_PASSWORD=change-me
# docker-compose 内置 MySQL（--profile mysql）时填服务名 mysql；外部库填实际地址
DB_HOST=127.0.0.1
DB_PORT=3306
# 连接复用秒数（Django CONN_MAX_AGE）。默认 60：不复用时每个请求都要重做一次
# TCP + 认证握手，任务执行抢 CPU 时这就是页面卡顿的一部分。
# 代价是常驻连接数上升（gunicorn 4 worker × 8 threads 最多 32 条，加 daphne 与
# celery），MySQL max_connections 需 ≥200；值不要超过 MySQL wait_timeout。
# 0 = 关闭复用（退回旧行为）
# DB_CONN_MAX_AGE=60
# 仅 docker-compose 内置 MySQL 需要（容器首次初始化 root 密码）
# MYSQL_ROOT_PASSWORD=change-me-root

# ── 任务执行 ─────────────────────────────────────────────
# thread（代码默认，无需 Redis）/ celery（需 Redis + worker）/ sync（测试用）
#
# ⚠ 生产请用 celery。thread 后端把 ansible 子进程和日志汇聚都放在 gunicorn
#   worker 进程里：ansible 一跑，那个 worker 就在和 API 抢 GIL 与 CPU，后台响应
#   随任务输出量一起变慢（现象是全站延迟、前端报 timeout，而服务端没有任何报错）。
#   而且 gunicorn worker 处理请求期间不向 arbiter 打点，请求超过 --timeout 会被
#   杀掉整个 worker，住在里面的 ansible 线程一起死，任务永远停在 running。
TASK_EXEC_BACKEND=celery
# TASK_EXEC_BACKEND=celery 时需要：
# REDIS_URL=redis://127.0.0.1:6379/0
#   ——以及【必须部署】任务执行专用 worker，消费独立队列 task_exec：
#     deploy/ops-manager-celery-exec.conf
#   worker 不在，任务就在队列里排队，页面上是一条永远「执行中」且无报错的任务。
#   自检：celery -A ops_manager inspect ping / redis-cli -n 0 llen task_exec
# 模块失败后等待人工处理（重试/跳过/中止）的超时秒数，超时按中止处理；
# 0 = 不等待（失败即中止）。系统配置 task.failure_wait_timeout 可运行时覆盖
# TASK_FAILURE_WAIT_TIMEOUT=600
# 并行组内同时执行的模块数上限（默认 5）。每个模块起一个 ansible 进程，再按任务的
# 「主机并发数」（forks，默认 10）派生子进程 —— 不封顶时 5 个模块就是 50 个进程。
# 核少的机器建议连同任务上的 forks 一起下调。
# TASK_PARALLEL_MAX=5
# 执行日志与现场归档的落盘目录（输出可能含敏感回显，勿放静态文件路径）
# TASK_LOG_DIR=/data/task-logs

# ── Channels（执行日志推送 / ops-agent 接入）──────────────
# redis（默认，跨进程）/ memory（进程内，仅「单 ASGI 进程 + TASK_EXEC_BACKEND=thread」可用）。
# 用 celery、或 gunicorn/daphne 多进程多实例、或 agent 的 WebSocket 与 runner 不同进程时，
# 必须是 redis，否则跨进程推送静默失效（前端回退轮询、agent 下发失败）
# CHANNEL_LAYER_BACKEND=redis

# ── 缓存与登录限速 ───────────────────────────────────────
# redis（默认，多进程必须）/ memory（进程内，仅本地开发）
# CACHE_BACKEND=redis
# 缓存 Redis 地址，默认与 REDIS_URL 同库（键有 opsmgr 前缀，不与 celery 串）
# CACHE_URL=redis://127.0.0.1:6379/0
# 登录失败限速：窗口内同一用户名失败 10 次 / 同一 IP 失败 50 次即锁 15 分钟
# LOGIN_FAIL_LIMIT=10
# LOGIN_FAIL_IP_LIMIT=50
# LOGIN_FAIL_WINDOW=900
# LOGIN_FAIL_BLOCK=900

# ── MFA（二次认证）─────────────────────────────────────────
# 【历史名字，新部署不要用】那时加密只服务 MFA，现在统一走上面的 SECRET_ENC_KEY。
# 保留它只为存量部署换名后密文还能解开：留空即可，配了会优先于 SECRET_ENC_KEY 之后、
# SECRET_KEY 之前生效（回退链：SECRET_ENC_KEY → MFA_SECRET_KEY → SECRET_KEY）
# MFA_SECRET_KEY=
# 验证器 App 里显示的归属名
# MFA_ISSUER=OpsManager
# 挑战票据有效期（秒）/ 单票据验证码错误上限 / 恢复码数量
# MFA_CHALLENGE_TTL=300
# MFA_MAX_ATTEMPTS=5
# MFA_RECOVERY_CODES=10
# 敏感操作二次验证窗口（秒）：改凭据/用户/Agent/云账号/系统配置 需重验
# SUDO_TTL=600
# 强制范围不在这里配：系统配置页的 mfa.enforce_scope（off/staff/all）

# ── 飞书接入（apps/im_mgr）────────────────────────────────
# 应用凭据不在这里配：「系统配置 → 飞书接入」页录入，加密落库
# 开放平台域名：飞书 open.feishu.cn / Lark（海外）open.larksuite.com
# FEISHU_BASE_URL=https://open.feishu.cn
# 出站是否使用环境代理（飞书在公网，多数部署需要代理才出得去）
# FEISHU_TRUST_ENV=True
# 出站超时（秒）
# FEISHU_CONNECT_TIMEOUT=5
# FEISHU_READ_TIMEOUT=10
# 网页免登授权页路径（飞书换过名字，旧版是 /open-apis/authen/v1/index）
# FEISHU_AUTHORIZE_PATH=/open-apis/authen/v1/authorize
# 回调入口按来源 IP 的限速
# FEISHU_CALLBACK_RATE=240/min
# 生产执行二次确认票据的有效期（秒）。短是刻意的：留久了就变成一张可以被
# 翻出来再点一次的按钮
# FEISHU_CONFIRM_TTL=60

# ── 云控：DNS 高危变更审批 ────────────────────────────────
# 关掉后高危变更直接执行（仍留痕、仍可回滚）。生产建议开启。
# 高危 = 改/删已生效解析、根域 @、NS/MX/CAA/TXT、受保护记录、指向生产主机
# DNS_APPROVAL_ENABLED=True
# 变更单有效期（小时）。另有一道执行前的漂移比对——光靠过期时间挡不住 24 小时内
# 线上值已被别人改过的情况
# DNS_APPROVAL_TTL_HOURS=24

# ── 证书管理（acme.sh + DNS 验证签发）─────────────────────
# acme.sh 可执行文件路径（默认 ~/.acme.sh/acme.sh，官方 curl 安装位置）
# ACME_BIN=/root/.acme.sh/acme.sh
# 证书与 acme 账号数据目录（含私钥，勿放静态文件路径）
# ACME_HOME=/data/acme
# ACME 账号注册邮箱（Let's Encrypt 到期提醒），生产建议配置
# ACME_EMAIL=ops@example.com
# CA：letsencrypt / zerossl / buypass 等 acme.sh --server 取值
# ACME_SERVER=letsencrypt
# 签发/续签子进程超时秒数（DNS 验证含传播等待，耗时数分钟）
# ACME_TIMEOUT=900
# 距过期不足 N 天时 beat 自动续签（renew_expiring_certificates）
# CERT_RENEW_BEFORE_DAYS=30

# ── Ansible ──────────────────────────────────────────────
# 集中管理的 Ansible 项目目录（playbook 模块 / ansible_playbook 方法在此执行剧本），
# 默认仓库内 ansible/ 目录
# ANSIBLE_PROJECT_DIR=/data/ansible-project
# 默认 inventory（相对项目目录或绝对路径，留空用项目 ansible.cfg）
# ANSIBLE_INVENTORY=

# ── 可选 ─────────────────────────────────────────────────
# 日志级别（prod 默认 WARNING）
# LOG_LEVEL=INFO
# 落盘日志格式：json（prod 默认，供 Vector 采集）/ verbose（人读文本，dev 默认）
# 应急排障想直接 tail 时可临时切回 verbose，但采集端会解析失败
# LOG_FORMAT=json
# 本进程身份：写进日志的 service 字段，同时决定文件名 logs/ops_manager-<service>.log。
# 正常由 supervisor 配置注入（django / ws / celery / celery-beat / celery-exec /
# feishu-ws），同机多个进程必须互不相同，否则写同一文件、轮转互相覆盖
# LOG_SERVICE=django
# 任务执行日志记录保留天数（默认 90）
# TASK_LOG_RETENTION_DAYS=90
# 落盘完整日志文件保留天数（默认 30，按 mtime 清理，含孤儿文件）
# TASK_LOG_FILE_RETENTION_DAYS=30
# ansible 彩色输出（默认 True，日志保留 ANSI 颜色码由前端着色）
# TASK_LOG_COLOR=True
# 制品落盘根目录（默认 media/artifacts）
# ARTIFACT_ROOT=/data/artifacts
# 制品保留天数（clean_artifacts 命令据此清理记录与文件；建议挂每日 cron）
# ARTIFACT_RETENTION_DAYS=90
# 每个 项目组/渠道/环境 组合保底保留的最新版本数，不受保留期限制
# （长期不发版的环境里所有制品都会超期，全清掉之后连回滚到上一版都做不到）
# ARTIFACT_KEEP_LATEST=3
# 制品下载交给 nginx 内部重定向的路径前缀（生产必开，值须与 nginx 的
# internal location 一致）。不开则由 gunicorn 逐块吐包，几十 MB 的下载会
# 占满 worker 并在慢客户端上中途断连。改前缀要同步改 nginx。
ARTIFACT_XACCEL_PREFIX=/_artifacts/
# JWT 有效期（默认 60 分钟 / 7 天）
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# 前端独立域名跨域时配置（同域 nginx 反代无需）
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# =============================================================================
# ── docker-compose 部署（裸机 supervisor 部署时以下全部不需要）─────────────
# 本段既被 compose 用于变量插值（镜像 tag、宿主路径、端口…），
# 也随 env_file 注入应用容器。首次部署顺序见 docker-compose.yml 头部注释。
# =============================================================================

# ── 镜像 ─────────────────────────────────────────────────────
# 回滚 = 把 TAG 指回上一个 commit 再 `docker compose up -d`，不需要重新构建
APP_IMAGE=ops-manager-backend
APP_IMAGE_TAG=latest
# 容器内 app 用户的 uid/gid，必须等于宿主上 logs/ media/ 目录的属主
# （`id -u homelab`）。与 make image 的 APP_UID/APP_GID、init-dirs.sh 三处一致。
APP_UID=1000
APP_GID=1000
TZ=Asia/Shanghai

# ── 宿主目录（全部 bind mount，不用具名 volume）───────────────
# 建目录并设属主：sudo bash deploy/docker/init-dirs.sh（首次 up 之前必须跑）
#   ${OPS_DATA_ROOT}/mysql        MySQL 数据
#   ${OPS_DATA_ROOT}/redis        Redis AOF/RDB
#   ${OPS_DATA_ROOT}/media        制品与 ACME 私钥（MEDIA_ROOT）
#   ${OPS_DATA_ROOT}/beat         celerybeat-schedule
#   ${OPS_DATA_ROOT}/staticfiles  init 容器导出、nginx 只读挂载
#   ${OPS_LOG_ROOT}/app           Django/celery 日志 + gunicorn access（Vector 采这里）
#   ${OPS_LOG_ROOT}/mysql         MySQL error/slow log
#   ${OPS_LOG_ROOT}/redis         Redis log
#   ${OPS_LOG_ROOT}/nginx         nginx access/error log
OPS_DATA_ROOT=/home/homelab/data/ops-manager
OPS_LOG_ROOT=/home/homelab/logs/ops-manager
# Ansible 项目目录（bind mount，加剧本不必重打镜像）
OPS_ANSIBLE_DIR=./ansible
# Ansible 免密私钥目录；容器内挂到 /home/app/.ssh（降权后 HOME 不再是 /root）
OPS_SSH_DIR=/home/homelab/.ssh
# 宿主已有的 acme.sh（证书签发用，只有 celery 容器挂它）
OPS_ACME_SH_DIR=/home/homelab/.acme.sh
# 前端构建产物（宿主 make frontend 产出，nginx 只读挂载）
OPS_FRONTEND_DIST=./frontend/dist

# ── 容器化后这三项的取值会变 ─────────────────────────────────
# 1) DB_HOST：用内置 MySQL（--profile mysql）填服务名 mysql
# 2) REDIS_URL：内置 Redis 带密码，库划分 0=celery / 1=channels / 2=cache
# 3) ALLOWED_HOSTS：必须含 127.0.0.1，否则容器 healthcheck 恒得 400、一直 unhealthy
# DB_HOST=mysql
REDIS_PASSWORD=change-me-redis
# REDIS_URL=redis://:change-me-redis@redis:6379/0
# CACHE_URL=redis://:change-me-redis@redis:6379/2
# 内置 MySQL 的 root 密码等在 deploy/docker/mysql.env（单独文件，不注入应用容器）

# ── 端口（只绑回环，公网入口是 host 网络下的 nginx）──────────
WEB_PORT=8000
WS_PORT=8001

# ── 内存上限（4C/3.7G 的分配；容器不设上限会一起把机器拖进 OOM）──
WEB_MEM_LIMIT=1g
WS_MEM_LIMIT=384m
CELERY_MEM_LIMIT=512m
CELERY_EXEC_MEM_LIMIT=768m
BEAT_MEM_LIMIT=256m
FEISHU_WS_MEM_LIMIT=384m
MYSQL_MEM_LIMIT=1g
REDIS_MEM_LIMIT=320m

# ── 前置 nginx（原 deploy/nginx/.env，已合并到这里）──────────
# host 网络模式：直接占宿主端口，需确保宿主原生 nginx 已停止。
# 保留 host 网络是为了拿到真实客户端 IP —— API 凭证 IP 白名单、飞书回调
# 来源校验、TRUSTED_PROXIES 三处都依赖它。理由见 docker-compose.yml。
OPS_NGINX_IMAGE=nginx:1.27-alpine
OPS_CONTAINER_NAME=ops_manager_nginx
OPS_HTTP_PORT=80
OPS_HTTPS_PORT=443
# 必须是域名：公网 CA 不为纯 IP 签发证书。多域名空格分隔。
OPS_SERVER_NAME=ops-manager.example.com
# CI 制品压缩包上报走 /api，放宽上传限制
OPS_CLIENT_MAX_BODY_SIZE=500m
# 任务执行 / Jenkins 日志同步是长请求，与 gunicorn --timeout 同量级
OPS_PROXY_TIMEOUT=600s
# 上游：host 网络下走回环，连到 web/ws 容器发布的端口
OPS_UPSTREAM_ADDR=127.0.0.1:8000
# nginx 模板里 root/alias 用的路径前缀。容器里各目录都按这个前缀挂载，
# 所以模板不需要改；它不必真实存在于宿主。
OPS_APP_ROOT=/home/homelab/apps/devops-manager
OPS_TLS_CERT=/etc/nginx/certs/ops-manager.example.com/ops-manager.example.com.crt
OPS_TLS_KEY=/etc/nginx/certs/ops-manager.example.com/ops-manager.example.com.key
OPS_TLS_CHAIN=/etc/nginx/certs/ops-manager.example.com/ops-manager.example.com.fullchain.pem
# ICP 备案占位站
OPS_BEIAN_SERVER_NAME=chengjiu.space www.chengjiu.space
OPS_BEIAN_INDEX=chengjiu.space.beian.html
# nginx 容器自身的健康检查地址（走 HTTP，避免自签证书导致校验失败）
OPS_HEALTHCHECK_URL=http://127.0.0.1/nginx-health
