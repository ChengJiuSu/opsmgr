# 生产环境变量模板：复制到项目根目录为 .env 并按实际环境修改
#   cp deploy/env.example /opt/devops-manager/.env
#
# ⚠ DJANGO_SETTINGS_MODULE 写在 .env 里【不生效】（decouple 不导出进程环境变量）。
#   生产 settings 的生效途径：
#     - gunicorn 走 ops_manager/wsgi.py：不设该变量时默认即 prod
#     - supervisor / systemd：deploy/ops-manager.conf(.service) 已显式注入
#   本地 manage.py 命令需要 prod 时显式带前缀：
#     DJANGO_SETTINGS_MODULE=ops_manager.settings.prod venv/bin/python manage.py migrate

# ── Django 核心 ──────────────────────────────────────────
# 随机长字符串，可用 `python -c "import secrets; print(secrets.token_urlsafe(50))"` 生成
SECRET_KEY=change-me
# 逗号分隔，填服务器 IP / 域名
ALLOWED_HOSTS=127.0.0.1,192.168.1.100

# 平台对外基础地址：拼接制品带签名下载 URL（CD 目标主机经此拉包），必配
SITE_BASE_URL=http://192.168.1.100

# ⚠⚠ 库内秘密的统一加密密钥。**首次上线必须在 migrate 之前配好**。
# 加密对象：连接凭据的密码/私钥/提权密码、云账号 AccessKey Secret、证书私钥、
#          敏感执行变量、MFA 的 TOTP 密钥 —— 这些都必须能还原（要建 SSH 连接、
#          调厂商 API、注入 ansible），所以不能只存哈希。
# 留空会回退用 SECRET_KEY 派生：那样将来轮换 SECRET_KEY 会让上述数据【全部解不开】
#          （表现为 SSH 认证失败、MFA 校验失败、任务执行报变量解密失败）。
# 它不是调用方的 API Key —— 那是「系统管理 → API 凭证」签发的 ak_xxx.yyy，
#          只存哈希、每个调用方一把，与这里无关。
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_ENC_KEY=change-me-and-never-rotate-casually

# 制品下载 URL 的签名密钥（Artifact.download_sig）。留空回退 SECRET_ENC_KEY。
# 换掉会让【已签发但还没用掉】的下载 URL 失效 —— 这些 URL 执行时现算现用，
# 影响面只限于换 key 那一刻正在跑的 CD。单独配可让它与其他秘密分开轮换。
# ARTIFACT_SIGN_KEY=

# ── 机读接口访问控制（API 凭证）──────────────────────────
# 本服务前置的反向代理地址（CIDR 或单 IP，逗号分隔）。
# ⚠ API 凭证的 IP 白名单只信这些地址转发来的 X-Forwarded-For；**多层代理必须把
#   每一层都写进来**（nginx、SLB、WAF），否则会把内层代理 IP 当成客户端，
#   导致所有白名单失配（fail-closed，表现是一律 403，报错里带实际观测到的 IP）。
# 默认只含回环：单机 nginx 反代（proxy_pass 到 127.0.0.1）即可工作。
TRUSTED_PROXIES=127.0.0.1,::1
# 单把凭证的默认限速（DRF 速率语法），凭证上可单独覆盖
# API_KEY_DEFAULT_RATE=60/min
# 凭证校验失败的锁定策略（按 key_id 计数，防拿到 key_id 后暴力猜 secret）
# API_KEY_FAIL_LIMIT=20
# API_KEY_FAIL_WINDOW=300
# API_KEY_FAIL_BLOCK=300
# 凭证「最近使用」写库的最小间隔（秒）：每请求一次 UPDATE 会把机读接口的写压力翻倍
# API_KEY_TOUCH_INTERVAL=60

# ── 数据库（MySQL，prod 配置使用；dev 配置固定 SQLite 不读这些）──
DB_NAME=ops_manager
DB_USER=ops
DB_PASSWORD=change-me
# docker-compose 内置 MySQL（--profile mysql）时填服务名 mysql；外部库填实际地址
DB_HOST=127.0.0.1
DB_PORT=3306
# 仅 docker-compose 内置 MySQL 需要（容器首次初始化 root 密码）
# MYSQL_ROOT_PASSWORD=change-me-root

# ── 任务执行 ─────────────────────────────────────────────
# thread（默认，无需 Redis）/ celery（需 Redis + worker）/ sync（测试用）
TASK_EXEC_BACKEND=thread
# TASK_EXEC_BACKEND=celery 时需要：
# REDIS_URL=redis://127.0.0.1:6379/0
# 模块失败后等待人工处理（重试/跳过/中止）的超时秒数，超时按中止处理；
# 0 = 不等待（失败即中止）。系统配置 task.failure_wait_timeout 可运行时覆盖
# TASK_FAILURE_WAIT_TIMEOUT=600
# 执行日志与现场归档的落盘目录（输出可能含敏感回显，勿放静态文件路径）
# TASK_LOG_DIR=/data/task-logs

# ── Channels（执行日志推送 / ops-agent 接入）──────────────
# redis（默认，跨进程）/ memory（进程内，仅「单 ASGI 进程 + TASK_EXEC_BACKEND=thread」可用）。
# 用 celery、或 gunicorn/daphne 多进程多实例、或 agent 的 WebSocket 与 runner 不同进程时，
# 必须是 redis，否则跨进程推送静默失效（前端回退轮询、agent 下发失败）
# CHANNEL_LAYER_BACKEND=redis

# ── 缓存与登录限速 ───────────────────────────────────────
# redis（默认，多进程必须）/ memory（进程内，仅本地开发）
# CACHE_BACKEND=redis
# 缓存 Redis 地址，默认与 REDIS_URL 同库（键有 opsmgr 前缀，不与 celery 串）
# CACHE_URL=redis://127.0.0.1:6379/0
# 登录失败限速：窗口内同一用户名失败 10 次 / 同一 IP 失败 50 次即锁 15 分钟
# LOGIN_FAIL_LIMIT=10
# LOGIN_FAIL_IP_LIMIT=50
# LOGIN_FAIL_WINDOW=900
# LOGIN_FAIL_BLOCK=900

# ── MFA（二次认证）─────────────────────────────────────────
# 【历史名字，新部署不要用】那时加密只服务 MFA，现在统一走上面的 SECRET_ENC_KEY。
# 保留它只为存量部署换名后密文还能解开：留空即可，配了会优先于 SECRET_ENC_KEY 之后、
# SECRET_KEY 之前生效（回退链：SECRET_ENC_KEY → MFA_SECRET_KEY → SECRET_KEY）
# MFA_SECRET_KEY=
# 验证器 App 里显示的归属名
# MFA_ISSUER=OpsManager
# 挑战票据有效期（秒）/ 单票据验证码错误上限 / 恢复码数量
# MFA_CHALLENGE_TTL=300
# MFA_MAX_ATTEMPTS=5
# MFA_RECOVERY_CODES=10
# 敏感操作二次验证窗口（秒）：改凭据/用户/Agent/云账号/系统配置 需重验
# SUDO_TTL=600
# 强制范围不在这里配：系统配置页的 mfa.enforce_scope（off/staff/all）

# ── 云控：DNS 高危变更审批 ────────────────────────────────
# 关掉后高危变更直接执行（仍留痕、仍可回滚）。生产建议开启。
# 高危 = 改/删已生效解析、根域 @、NS/MX/CAA/TXT、受保护记录、指向生产主机
# DNS_APPROVAL_ENABLED=True
# 变更单有效期（小时）。另有一道执行前的漂移比对——光靠过期时间挡不住 24 小时内
# 线上值已被别人改过的情况
# DNS_APPROVAL_TTL_HOURS=24

# ── 证书管理（acme.sh + DNS 验证签发）─────────────────────
# acme.sh 可执行文件路径（默认 ~/.acme.sh/acme.sh，官方 curl 安装位置）
# ACME_BIN=/root/.acme.sh/acme.sh
# 证书与 acme 账号数据目录（含私钥，勿放静态文件路径）
# ACME_HOME=/data/acme
# ACME 账号注册邮箱（Let's Encrypt 到期提醒），生产建议配置
# ACME_EMAIL=ops@example.com
# CA：letsencrypt / zerossl / buypass 等 acme.sh --server 取值
# ACME_SERVER=letsencrypt
# 签发/续签子进程超时秒数（DNS 验证含传播等待，耗时数分钟）
# ACME_TIMEOUT=900
# 距过期不足 N 天时 beat 自动续签（renew_expiring_certificates）
# CERT_RENEW_BEFORE_DAYS=30

# ── Ansible ──────────────────────────────────────────────
# 集中管理的 Ansible 项目目录（playbook 模块 / ansible_playbook 方法在此执行剧本），
# 默认仓库内 ansible/ 目录
# ANSIBLE_PROJECT_DIR=/data/ansible-project
# 默认 inventory（相对项目目录或绝对路径，留空用项目 ansible.cfg）
# ANSIBLE_INVENTORY=

# ── 可选 ─────────────────────────────────────────────────
# 日志级别（prod 默认 WARNING）
# LOG_LEVEL=INFO
# 任务执行日志记录保留天数（默认 90）
# TASK_LOG_RETENTION_DAYS=90
# 落盘完整日志文件保留天数（默认 30，按 mtime 清理，含孤儿文件）
# TASK_LOG_FILE_RETENTION_DAYS=30
# ansible 彩色输出（默认 True，日志保留 ANSI 颜色码由前端着色）
# TASK_LOG_COLOR=True
# 制品落盘根目录（默认 media/artifacts）
# ARTIFACT_ROOT=/data/artifacts
# 制品保留天数（clean_artifacts 命令据此清理记录与文件；建议挂每日 cron）
# ARTIFACT_RETENTION_DAYS=90
# 每个 项目组/渠道/环境 组合保底保留的最新版本数，不受保留期限制
# （长期不发版的环境里所有制品都会超期，全清掉之后连回滚到上一版都做不到）
# ARTIFACT_KEEP_LATEST=3
# JWT 有效期（默认 60 分钟 / 7 天）
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# 前端独立域名跨域时配置（同域 nginx 反代无需）
# CORS_ALLOWED_ORIGINS=http://localhost:5173
