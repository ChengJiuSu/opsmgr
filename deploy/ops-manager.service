# OpsManager Django 后端 systemd 服务
# 安装：
#   sudo cp deploy/ops-manager.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ops-manager
# 部署路径非 /opt/devops-manager 时同步修改下方三处路径。
[Unit]
Description=OpsManager Django backend (gunicorn)
After=network.target mysql.service

[Service]
User=ops
Group=ops
WorkingDirectory=/opt/devops-manager
Environment=DJANGO_SETTINGS_MODULE=ops_manager.settings.prod
# venv/bin 置于 PATH 头部：任务执行需在 PATH 上找到 ansible/ansible-playbook
Environment=PATH=/opt/devops-manager/venv/bin:/usr/local/bin:/usr/bin:/bin
# --timeout 600：任务执行 / Jenkins 日志同步为长请求，勿调小
ExecStart=/opt/devops-manager/venv/bin/gunicorn ops_manager.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 4 \
    --timeout 600 \
    --access-logfile /opt/devops-manager/logs/gunicorn-access.log \
    --error-logfile /opt/devops-manager/logs/gunicorn-error.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
