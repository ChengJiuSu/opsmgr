# OpsManager Celery worker（TASK_EXEC_BACKEND=celery 时必须部署）
# 安装：
#   sudo cp deploy/ops-manager-celery.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ops-manager-celery
#
# 为什么必须托管：web 进程只负责置状态（issuing / deploying）+ 把任务丢进 Redis，
# 消费全靠这个 worker。worker 不在，任务就在队列里排队，页面上只看到一条永远
# 「申请中」的证书——没有任何报错。`celery -A ops_manager inspect ping` 无回应 +
# `redis-cli llen celery` 不为 0 就是这个状态。
#
# 部署路径 / 运行用户非下方值时同步修改（三处路径 + User/Group）。
[Unit]
Description=OpsManager Celery worker (task_exec / cert issue & deploy)
After=network.target redis.service mysql.service

[Service]
User=ops
Group=ops
WorkingDirectory=/opt/devops-manager
Environment=DJANGO_SETTINGS_MODULE=ops_manager.settings.prod
# venv/bin 与 ~/.acme.sh 必须在 PATH 上：证书签发要找 acme.sh，任务执行要找 ansible。
# ACME_BIN 未显式配置时默认 ~/.acme.sh/acme.sh，按运行用户的家目录解析——
# worker 与 web 的运行用户必须一致，否则找不到 acme.sh 或读不到已签发的证书目录。
# 下方 /home/ops/.acme.sh 按 User= 的实际家目录改。
Environment=PATH=/opt/devops-manager/venv/bin:/home/ops/.acme.sh:/usr/local/bin:/usr/bin:/bin
# --concurrency=2：签发/分发都是长任务（acme.sh DNS 验证最长 900s），不需要高并发；
# 同一台主机的分发已在任务内串行，调大只会抢同一批目标机。
ExecStart=/opt/devops-manager/venv/bin/celery -A ops_manager worker \
    -l info \
    --concurrency=2 \
    --logfile=/opt/devops-manager/logs/celery-worker.log
Restart=always
RestartSec=3
# 长任务收尾时间：acme.sh 单次签发上限 ACME_TIMEOUT(900s)，停服务别把它砍在中途
TimeoutStopSec=930
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
