# =============================================================================
# VictoriaLogs 的鉴权入口（VictoriaLogs 自身没有任何认证，这一层不是可选项）
# -----------------------------------------------------------------------------
# 装到日志服务器的 nginx 上，与 victoria-logs.service 的
# -httpListenAddr=127.0.0.1:9428 配套：外部只能经这里进来。
#
# 口令文件：
#   printf 'vector:%s\n' "$(openssl passwd -apr1)" >> /etc/nginx/vlogs.write.htpasswd
#   printf 'ops:%s\n'    "$(openssl passwd -apr1)" >> /etc/nginx/vlogs.read.htpasswd
#   chown root:www-data /etc/nginx/vlogs.*.htpasswd && chmod 640 /etc/nginx/vlogs.*.htpasswd
#
# 读写分开两个口令文件：采集 agent 的口令散在每台机的 /etc/vector/vector.env 里，
# 面比人用的查询口令大得多。一旦某台机被拿下，轮换写口令不影响查询侧。
# =============================================================================

server {
    listen 443 ssl;
    http2 on;
    server_name vlogs.internal;

    ssl_certificate     /etc/nginx/certs/vlogs.internal.crt;
    ssl_certificate_key /etc/nginx/certs/vlogs.internal.key;

    # 日志里有内网 IP、接口路径、用户名，明文传等于沿途泄露。TLS 不是装饰。
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/vlogs.access.log;
    error_log  /var/log/nginx/vlogs.error.log warn;

    # 一条日志批量可达数 MB（gzip 前），默认 1m 会让 agent 反复 413 重试
    client_max_body_size 64m;

    # ── 写入：只给采集 agent ────────────────────────────────
    location /insert/ {
        # 防火墙之外再加一道来源限制。写口子被拿到 = 攻击者能灌伪造日志把真实
        # 记录淹掉（也就是在需要查的时候恰好查不到），比读泄露更隐蔽。
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny  all;

        auth_basic "vlogs write";
        auth_basic_user_file /etc/nginx/vlogs.write.htpasswd;

        proxy_pass http://127.0.0.1:9428;
        proxy_set_header Host $host;
        # 采集端是长连接批量推送，超时别按普通接口配
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # 已经是 gzip 过的请求体，nginx 不要再缓冲整包
        proxy_request_buffering off;
    }

    # ── 查询 / vmui：只给运维 ───────────────────────────────
    location /select/ {
        allow 10.0.0.0/8;
        deny  all;

        auth_basic "vlogs read";
        auth_basic_user_file /etc/nginx/vlogs.read.htpasswd;

        proxy_pass http://127.0.0.1:9428;
        proxy_set_header Host $host;
        # 大范围查询要跑一会儿
        proxy_read_timeout 300s;
    }

    # 其余路径（含 /-/reload、/internal/ 之类的管理面）一律不暴露。
    # 默认拒绝，要开哪个再单独加 location，别图省事 proxy_pass 整个 /。
    location / {
        return 404;
    }
}
