# VictoriaLogs 日志服务端（单机）
#
# 安装：
#   useradd --system --no-create-home --shell /usr/sbin/nologin vlogs
#   install -o vlogs -g vlogs -d /home/homelab/data/victoria-logs
#   # vlogs 要能穿过 /home/homelab 这一层目录才进得去数据目录
#   usermod -aG homelab vlogs && chmod g+x /home/homelab
#   install -m 0755 victoria-logs-prod /usr/local/bin/victoria-logs
#   cp victoria-logs.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now victoria-logs
#
# 认证：内网环境，已决定不做（无 nginx 鉴权层、无 basic auth）。
#   VictoriaLogs 自身没有任何认证机制，所以访问控制完全落在网络边界上：
#   能连到这个端口的人即可读全部日志，也可往 /insert/* 写任意内容。
#   现配置 -httpListenAddr=0.0.0.0:9428，即监听本机【所有】网卡。这台机若有
#   公网网卡，9428 就是直接对公网开的：任何人可读全部日志、可往 /insert/* 写
#   任意内容（伪造日志淹没真实记录）。安全边界因此完全落在云安全组 / iptables
#   上——部署后务必确认 9428 只对内网网段放行，这是目前唯一的防线。

[Unit]
Description=VictoriaLogs
Documentation=https://docs.victoriametrics.com/victorialogs/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vlogs
Group=vlogs

# -retentionPeriod：先定 30 天。日志量未实测，上线后按实际磁盘增长再调。
# -retention.maxDiskSpaceUsagePercent：保留期之外的硬兜底。磁盘写满会让整个
#   日志服务停摆（且常常连带同机的其他服务），比少存几天严重得多。
# -storageDataPath：放在 /home/homelab 下（这台机的数据盘挂在那儿），
#   不用 /var/lib。配套见下面的 ProtectHome=false 与 ReadWritePaths——
#   三处必须一致，改其中一处而漏掉另外两处的表现是「服务起来了但写不进去」。
# -futureRetention：拒收时间戳过于超前的数据。采集端时钟跑偏或伪造的时间戳会
#   在时间轴远端堆出永远不过期的数据。
ExecStart=/usr/local/bin/victoria-logs \
    -storageDataPath=/home/homelab/data/victoria-logs \
    -httpListenAddr=0.0.0.0:9428 \
    -retentionPeriod=30d \
    -retention.maxDiskSpaceUsagePercent=80 \
    -futureRetention=2d \
    -loggerFormat=json \
    -loggerOutput=stderr

Restart=always
RestartSec=5s
# 索引与合并会开大量文件句柄，默认 1024 不够
LimitNOFILE=65536
# 停止时给足时间把内存中的数据刷盘，SIGKILL 会丢最近一批
TimeoutStopSec=60

# ── 沙箱 ───────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# 数据目录在 /home/homelab 下，必须关掉，见下方 ReadWritePaths
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# ProtectSystem=strict 下整个文件系统只读，数据目录必须显式开写。
# 数据目录在 /home 下，所以 ProtectHome 不能开（开了 /home 对本服务不可见）。
ReadWritePaths=/home/homelab/data/victoria-logs

[Install]
WantedBy=multi-user.target
