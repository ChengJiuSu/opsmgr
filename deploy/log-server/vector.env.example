# /etc/vector/vector.env —— 每台机按实际情况填，chmod 0640 root:vector
# （含 VictoriaLogs 的写入口令，不要给 other 读权限）

# 本机部署目录，决定应用日志位置 <OPS_APP_DIR>/logs/ops_manager-*.log
#   homelab 机：/home/homelab/apps/devops-manager
#   ubuntu 机： /home/ubuntu/apps/devops-manager-01
OPS_APP_DIR=/home/homelab/apps/devops-manager

# supervisor 的 stdout/stderr 落盘目录（各机的 stdout_logfile 父目录）
OPS_LOG_DIR=/home/homelab/logs

# 环境标识，进日志的 env 字段（stream 字段之一，只能是少数几个固定值）
OPS_ENV=prod

# VictoriaLogs 写入地址：走 nginx 的鉴权入口，不是 9428 裸端口
VLOGS_ENDPOINT=https://vlogs.internal
VLOGS_USER=vector
VLOGS_PASSWORD=change-me

# 本机是否有 nginx（只有入口机有）。无 nginx 的机器把 vector.toml 里
# nginx_* 两个 source 和 sink 的对应 inputs 删掉，或让 include 指向空目录。
