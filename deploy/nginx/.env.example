# =============================================================================
# 容器化 nginx 环境变量模板
#   cp deploy/nginx/.env.example deploy/nginx/.env && vim deploy/nginx/.env
#
# 实际的 .env 不入库（.gitignore 的 .env / .env.* 规则），本文件只给键名与说明，
# 不含任何真实值。改完在本目录 `docker compose up -d`。
# 变量分两组：OPS_* 注入容器（compose 的 NGINX_ENVSUBST_FILTER=^OPS_ 决定只有
# 这个前缀会被 envsubst 渲染进 conf.d），ACME_*/Ali_* 只给宿主机的签发脚本用。
# =============================================================================

# ── 容器与镜像 ───────────────────────────────────────────────
# 留空则用 compose 里的默认值（nginx:1.27-alpine / ops_manager_nginx / Asia/Shanghai）
OPS_NGINX_IMAGE=nginx:1.27-alpine
OPS_CONTAINER_NAME=ops_manager_nginx
TZ=Asia/Shanghai

# ── 站点 ─────────────────────────────────────────────────────
# host 网络模式下直接占用宿主机端口，需确保宿主机原生 nginx 已停止
OPS_HTTP_PORT=80
OPS_HTTPS_PORT=443
# 必须是域名：公网 CA 不为纯 IP 签发证书。多域名用空格分隔。
# 内网场景配合 split-horizon DNS 把该域名解析到内网地址。
OPS_SERVER_NAME=ops-manager.example.com
# CI 制品压缩包上报走 /api，放宽上传限制
OPS_CLIENT_MAX_BODY_SIZE=500m

# ── ICP 备案占位站 ───────────────────────────────────────────
# 与主站同机不同域名，只提供一个静态首页（不跳转，见
# conf/templates/ops_manager_beian.conf.template）。多域名用空格分隔，
# 备案主域名 + www 一般都要写上。
OPS_BEIAN_SERVER_NAME=chengjiu.space www.chengjiu.space
# 页面文件名，位于宿主机 ./html/（挂到容器 /etc/nginx/html-sites）
OPS_BEIAN_INDEX=chengjiu.space.beian.html
# 该域名单独的证书。仅在模板里取消 HTTPS 块注释时才需要，
# 同时要在 compose 的 environment 里透传这两个变量。
# OPS_BEIAN_TLS_CERT=/etc/nginx/certs/chengjiu.space/chengjiu.space.crt
# OPS_BEIAN_TLS_KEY=/etc/nginx/certs/chengjiu.space/chengjiu.space.key

# ── TLS 证书（容器内路径，对应宿主机 ./certs 挂载）────────────
OPS_TLS_CERT=/etc/nginx/certs/ops-manager.example.com/ops-manager.example.com.crt
OPS_TLS_KEY=/etc/nginx/certs/ops-manager.example.com/ops-manager.example.com.key
# 仅在模板里启用 OCSP Stapling 时才会用到（中间证书链）
OPS_TLS_CHAIN=/etc/nginx/certs/ops-manager.example.com/ops-manager.example.com.fullchain.pem

# ── 后端上游 ─────────────────────────────────────────────────
# gunicorn（WSGI，HTTP API）。host 网络模式下走 loopback。
OPS_UPSTREAM_ADDR=127.0.0.1:8000
# daphne（ASGI，/ws/）的地址目前**硬编码**在 ops_manager.conf.template 的
# upstream ops_manager_backend_ws 里（127.0.0.1:8001）。要改成可配时，
# 模板里换成 ${OPS_UPSTREAM_ADDR_WS} 并在 compose 的 environment 里透传。
# OPS_UPSTREAM_ADDR_WS=127.0.0.1:8001

# 任务执行 / Jenkins 日志同步是长请求，与后端 gunicorn --timeout 同量级
OPS_PROXY_TIMEOUT=600s

# ── 应用部署根目录 ───────────────────────────────────────────
# 前端 dist、staticfiles、media 由 compose 以「宿主机路径 = 容器内路径」挂载，
# 所以模板里的 root/alias 不需要做路径转换
OPS_APP_ROOT=/home/homelab/apps/devops-manager

# =============================================================================
# 以下变量【不注入容器】，只供宿主机上的证书签发脚本（acme.sh）使用
# =============================================================================
# ACME 账号邮箱
ACME_EMAIL=ops@example.com
# 证书主域名（与 OPS_SERVER_NAME 的第一个域名一致）
ACME_DOMAIN=ops-manager.example.com
# acme.sh 的 dnsapi 名称：dns_ali / dns_dp / dns_cf 等
ACME_DNS_PROVIDER=dns_ali
# DNS 提供商凭据。变量名由 acme.sh 的 dnsapi 决定（此处为阿里云）。
# ⚠ 建议用仅含 AliyunDNSFullAccess 的子账号 AK，且切勿填进本模板文件——
#   只写在不入库的 .env 里。
Ali_Key=
Ali_Secret=
