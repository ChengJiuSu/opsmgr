# =============================================================================
# OpsManager nginx 站点配置模板（HTTP + HTTPS）
# -----------------------------------------------------------------------------
# 由官方 nginx 镜像的 docker-entrypoint.d/20-envsubst-on-templates.sh 渲染，
# 输出到容器内 /etc/nginx/conf.d/ops_manager.conf。
#
# NGINX_ENVSUBST_FILTER=^OPS_ 保证只替换 OPS_ 前缀变量，
# $host / $uri / $remote_addr 等 nginx 内置变量保持原样。
# =============================================================================

# 自定义日志格式：combined 基础上追加请求耗时与上游各阶段耗时。
#   rt  = 请求总耗时          uct = 与上游建连耗时
#   uht = 上游返回响应头耗时   urt = 上游完整响应耗时
#   ssl = 协商出的 TLS 版本    cip = 协商出的加密套件
log_format ops_timing '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for" '
                      'rt=$request_time uct="$upstream_connect_time" '
                      'uht="$upstream_header_time" urt="$upstream_response_time" '
                      'ssl="$ssl_protocol" cip="$ssl_cipher"';

# 后端上游：宿主机上由 Supervisor 托管的 Gunicorn
upstream ops_manager_backend {
    server ${OPS_UPSTREAM_ADDR};
    keepalive 32;
}

upstream ops_manager_backend_ws {
    server 127.0.0.1:8001;
    keepalive 32;
}

# -----------------------------------------------------------------------------
# TLS 全局参数（conf.d 位于 http 块内，可直接定义）
# -----------------------------------------------------------------------------
# 只保留 TLS 1.2 / 1.3；1.0/1.1 已被主流浏览器与合规基线弃用
ssl_protocols TLSv1.2 TLSv1.3;

# 仅前向安全的 AEAD 套件；TLS 1.3 套件由 OpenSSL 固定，无需在此声明
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
ssl_prefer_server_ciphers off;   # TLS 1.3 下由客户端选择更优，遵循 Mozilla intermediate 建议
ssl_ecdh_curve X25519:prime256v1:secp384r1;

# 会话复用：降低重复握手开销；关闭 session ticket 以保证前向安全
ssl_session_cache shared:ops_ssl:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# =============================================================================
# HTTP 服务：健康检查 + ACME 校验 + 全量跳转 HTTPS
# =============================================================================
server {
    listen ${OPS_HTTP_PORT};
    server_name ${OPS_SERVER_NAME};
    server_tokens off;

    access_log /var/log/nginx/ops-manager.access.log ops_timing;
    error_log  /var/log/nginx/ops-manager.error.log warn;

    # 容器健康检查端点，不参与跳转（避免 healthcheck 拿到 301）
    location = /nginx-health {
        access_log off;
        default_type text/plain;   # 用 default_type 而非 add_header，避免顶掉安全头
        return 200 "ok\n";
    }

    # ACME http-01 校验路径。使用 DNS-01 时该目录为空，保留不影响。
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        access_log off;
    }

    # 其余请求一律跳 HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# =============================================================================
# HTTPS 主服务
# =============================================================================
server {
    listen ${OPS_HTTPS_PORT} ssl;
    http2 on;                      # nginx 1.25+ 独立指令，不再写在 listen 后
    server_name ${OPS_SERVER_NAME};
    server_tokens off;

    # ---- 证书 ----------------------------------------------------------------
    # 路径为容器内路径，由 compose 将宿主机 ./certs 挂载到 /etc/nginx/certs
    ssl_certificate     ${OPS_TLS_CERT};
    ssl_certificate_key ${OPS_TLS_KEY};

    # OCSP Stapling：仅在使用公网 CA 证书时开启。
    # 内部 CA / 自签证书没有 OCSP responder，开启会在 error.log 刷警告。
    # 需要时取消下面四行注释，并把 resolver 指向内网 DNS。
    # ssl_stapling on;
    # ssl_stapling_verify on;
    # ssl_trusted_certificate ${OPS_TLS_CHAIN};
    # resolver 192.168.60.1 valid=300s ipv6=off;
    # resolver_timeout 5s;

    # ---- 安全响应头 ----------------------------------------------------------
    # 注意：add_header 是「就近替换」不是「叠加」，任何自带 add_header 的
    # location 都必须再 include 一次本片段，否则安全头会静默丢失。
    include /etc/nginx/snippets/security_headers.conf;

    # CI 制品压缩包上报走 /api，放宽上传限制
    client_max_body_size ${OPS_CLIENT_MAX_BODY_SIZE};

    access_log /var/log/nginx/ops-manager.access.log ops_timing;
    error_log  /var/log/nginx/ops-manager.error.log warn;

    location = /nginx-health {
        access_log off;
        default_type text/plain;   # 用 default_type 而非 add_header，避免顶掉安全头
        return 200 "ok\n";
    }

    # ---- 前端静态资源（vite 构建产物），SPA 回退 index.html --------------------
    location / {
        root ${OPS_APP_ROOT}/frontend/dist;
        try_files $uri $uri/ /index.html;

        # 带 hash 的构建产物可长缓存；index.html 必须不缓存，否则发版不生效
        location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$ {
            expires 30d;
            include /etc/nginx/snippets/security_headers.conf;
            add_header Cache-Control "public, immutable";
            access_log off;
        }
        location = /index.html {
            include /etc/nginx/snippets/security_headers.conf;
            add_header Cache-Control "no-store";
        }
    }

    # ---- 后端 API / Django admin ---------------------------------------------
    location ~ ^/(api|admin)/ {
        access_log /var/log/nginx/ops-manager.api.access.log ops_timing;

        proxy_pass http://ops_manager_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # 关键：Django 侧需配置 SECURE_PROXY_SSL_HEADER 才会识别为 HTTPS 请求
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        # 任务执行 / Jenkins 日志同步为长请求
        proxy_connect_timeout 10s;
        proxy_read_timeout  ${OPS_PROXY_TIMEOUT};
        proxy_send_timeout  ${OPS_PROXY_TIMEOUT};

        # 日志流式返回场景关闭缓冲
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # 机读接口的网络层粗粒度兜底（可选，与后台 per-key IP 白名单叠加）。
    #
    # 分工：per-key 白名单管「哪把 key 能从哪来」，防火墙/nginx 管「这些路径
    # 根本不该从公网被摸到」。前者拦不住扫描流量（校验发生在应用层），后者做不到
    # 按 key 区分（同一台机器上多把 key 长得一样）——两层不可互相替代。
    #
    # 只放行内网与已知出口的场景，取消注释并按实际网段调整；对接公网 Webhook
    # （GitHub/云厂商，源 IP 段大且会变）时不要在这里限制，交给 per-key 白名单。
    # location ~ ^/api/(exec/tasks/[0-9]+/trigger|artifacts/report)/ {
    #     allow 10.0.0.0/8;        # 内网
    #     allow 203.0.113.9;       # CI 出口
    #     deny all;
    #
    #     access_log /var/log/nginx/ops-manager.api.access.log ops_timing;
    #     proxy_pass http://ops_manager_backend;
    #     proxy_http_version 1.1;
    #     proxy_set_header Connection "";
    #     proxy_set_header Host              $host;
    #     proxy_set_header X-Real-IP         $remote_addr;
    #     proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    #     proxy_read_timeout  ${OPS_PROXY_TIMEOUT};
    #     proxy_send_timeout  ${OPS_PROXY_TIMEOUT};
    # }
    
    # 制品文件内部重定向：只能由后端 X-Accel-Redirect 命中（internal），
    # 外部直接访问 /_artifacts/... 返回 404。后端 settings 里的
    # ARTIFACT_XACCEL_PREFIX 必须与这里的前缀一致（默认 /_artifacts/）。
    # 鉴权仍在 Django 的 /api/artifacts/<id>/download/ 做，这里只负责发文件，
    # 几十 MB 的包由 nginx sendfile 直发，不再占着 gunicorn worker。
    location /_artifacts/ {
        internal;
        alias ${OPS_APP_ROOT}/media/artifacts/;  # = ARTIFACT_ROOT
        access_log off;
    }

    # ops-agent WebSocket 接入：daphne（ASGI）监听 8001，仅承载 /ws/；
    # HTTP API 仍走上面的 WSGI（8000），互不影响。
    location /ws/ {
        proxy_pass http://ops_manager_backend_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 长连接：读超时需大于 agent 心跳间隔（30s），给足余量
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ---- Django collectstatic 产物（admin / drf-spectacular 等） ---------------
    location /static/ {
        alias ${OPS_APP_ROOT}/staticfiles/;
        expires 7d;
        access_log off;
    }

    # ---- /media/ 一律不对外提供 -------------------------------------------------
    # 曾经这里是 `alias ${OPS_APP_ROOT}/media/`，等于把整个 MEDIA_ROOT 挂上公网。
    # MEDIA_ROOT 下不止制品：
    #   media/artifacts/  —— 直出会绕开 /api/artifacts/<id>/download/ 的签名鉴权
    #   media/acme/       —— ACME_HOME 默认值，里面有 TLS 私钥与 ACME 账号私钥
    # 制品下载只走上面的签名接口（后端吐 X-Accel-Redirect，nginx 从内部的
    # /_artifacts/ 发文件）。不要再把这个 location 改回 alias。
    location /media/ {
        access_log off;
        return 404;
    }
}
