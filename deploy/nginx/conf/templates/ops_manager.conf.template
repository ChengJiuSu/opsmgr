# =============================================================================
# OpsManager nginx 站点配置模板（HTTP + HTTPS）
# -----------------------------------------------------------------------------
# 由官方 nginx 镜像的 docker-entrypoint.d/20-envsubst-on-templates.sh 渲染，
# 输出到容器内 /etc/nginx/conf.d/ops_manager.conf。
#
# NGINX_ENVSUBST_FILTER=^OPS_ 保证只替换 OPS_ 前缀变量，
# $host / $uri / $remote_addr 等 nginx 内置变量保持原样。
# =============================================================================

# 自定义日志格式：字段与原 ops_timing 一一对应，改成 JSON 单行。
#   rt  = 请求总耗时          uct = 与上游建连耗时
#   uht = 上游返回响应头耗时   urt = 上游完整响应耗时
#   ssl = 协商出的 TLS 版本    cip = 协商出的加密套件
#   rid = 请求 ID（$request_id 由 nginx 生成，同时经 proxy_backend.conf 下发给
#         Django，两侧日志用同一个值串起来：`request_id:xxx` 一次查出全链路）
#
# ⚠ escape=json 不能省：UA 和 referer 是客户端可控字符串，里面的引号/反斜杠
#   不转义会直接破坏 JSON 结构，采集端整行解析失败（而且是攻击者可主动触发的）。
#   nginx 1.11.8+ 支持。
#
# 空值口径：nginx 对未命中的变量输出空串，$upstream_* 在非反代 location（静态
# 文件）下就是空。因此耗时类字段一律加引号按字符串出，写成裸数字会产出
# `"urt":` 后面直接跟逗号的坏 JSON。查询侧在 VictoriaLogs 里用 `urt:>1` 前
# 需要 `math` 转换，代价远小于整行解析失败。
log_format ops_json escape=json
    '{"ts":"$time_iso8601","remote_addr":"$remote_addr","user":"$remote_user",'
    '"method":"$request_method","uri":"$uri","args":"$args",'
    '"status":$status,"bytes":$body_bytes_sent,'
    '"referer":"$http_referer","ua":"$http_user_agent",'
    '"xff":"$http_x_forwarded_for","rid":"$request_id",'
    '"rt":"$request_time","uct":"$upstream_connect_time",'
    '"uht":"$upstream_header_time","urt":"$upstream_response_time",'
    '"ssl":"$ssl_protocol","cip":"$ssl_cipher"}';

# -----------------------------------------------------------------------------
# 响应压缩
# -----------------------------------------------------------------------------
# 官方 nginx 镜像自带的 nginx.conf 里 gzip 是注释掉的，不在这里开就等于没开。
# API 返回的是列表 JSON，压缩比通常 5-10 倍：一个 10KB 的 /api/artifacts/
# 响应压完 1-2KB，慢链路上省下的传输时间比后端处理时间还多。
gzip on;
gzip_comp_level 5;        # 5 是 CPU/压缩比拐点，再往上收益递减
gzip_min_length 1024;     # 比这小的包，压缩头开销盖过收益
gzip_proxied any;         # 本站前面再套 CDN 时也照常压
gzip_vary on;             # 必须：静态资源带 30d immutable，缓存要按编码分桶
# ⚠ 不要写 text/html —— 它永远被压缩，显式列出会报 "duplicate MIME type"
gzip_types
    application/json
    application/javascript
    text/javascript
    text/css
    text/plain
    text/xml
    application/xml
    image/svg+xml;

# 前端构建产物没有预压缩（vite 未挂 compression 插件），故不开 gzip_static。
# 若日后在构建阶段产出 .gz，打开下面一行可省掉每次请求的实时压缩开销：
# gzip_static on;

# sendfile 由镜像默认 nginx.conf 开启；tcp_nopush 让 sendfile 攒满一个 MSS
# 再发，减少大静态文件的小包数量
tcp_nopush on;

# -----------------------------------------------------------------------------
# 飞书回调入口的限速桶（http 级，conf.d 在 http 块内）
# -----------------------------------------------------------------------------
# 回调是本站唯一「任何人都能直接 POST」的公网入口。验签在应用层，扫描流量在
# 到达验签之前就该被挡掉，否则每个探测包都会让后端做一次 SHA256 + 一次 AES。
# 10m 的共享内存约能跟踪 16 万个 IP，足够有余。
limit_req_zone $binary_remote_addr zone=feishu_callback:10m rate=60r/m;

# 后端上游：宿主机上由 Supervisor 托管的 Gunicorn
upstream ops_manager_backend {
    server ${OPS_UPSTREAM_ADDR};
    # 连接池：避免每个 API 请求都跟 gunicorn 走一次 TCP 握手。
    # keepalive_requests 不设时默认只有 1000，到点连接被关掉重建；
    # keepalive_timeout 需小于 gunicorn 侧空闲回收，60s 是安全值。
    keepalive 32;
    keepalive_requests 10000;
    keepalive_timeout 60s;
}

upstream ops_manager_backend_ws {
    server 127.0.0.1:8001;
    keepalive 32;
}

# -----------------------------------------------------------------------------
# TLS 全局参数（conf.d 位于 http 块内，可直接定义）
# -----------------------------------------------------------------------------
# 只保留 TLS 1.2 / 1.3；1.0/1.1 已被主流浏览器与合规基线弃用
ssl_protocols TLSv1.2 TLSv1.3;

# 仅前向安全的 AEAD 套件；TLS 1.3 套件由 OpenSSL 固定，无需在此声明
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
ssl_prefer_server_ciphers off;   # TLS 1.3 下由客户端选择更优，遵循 Mozilla intermediate 建议
ssl_ecdh_curve X25519:prime256v1:secp384r1;

# 会话复用：降低重复握手开销；关闭 session ticket 以保证前向安全
ssl_session_cache shared:ops_ssl:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# =============================================================================
# HTTP 服务：健康检查 + ACME 校验 + 全量跳转 HTTPS
# =============================================================================
server {
    listen ${OPS_HTTP_PORT};
    server_name ${OPS_SERVER_NAME};
    server_tokens off;

    access_log /var/log/nginx/ops-manager.access.log ops_json;
    error_log  /var/log/nginx/ops-manager.error.log warn;

    # 容器健康检查端点，不参与跳转（避免 healthcheck 拿到 301）
    location = /nginx-health {
        access_log off;
        default_type text/plain;   # 用 default_type 而非 add_header，避免顶掉安全头
        return 200 "ok\n";
    }

    # ACME http-01 校验路径。使用 DNS-01 时该目录为空，保留不影响。
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        access_log off;
    }

    # 其余请求一律跳 HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# =============================================================================
# HTTPS 主服务
# =============================================================================
server {
    listen ${OPS_HTTPS_PORT} ssl;
    http2 on;                      # nginx 1.25+ 独立指令，不再写在 listen 后
    server_name ${OPS_SERVER_NAME};
    server_tokens off;

    # ---- 证书 ----------------------------------------------------------------
    # 路径为容器内路径，由 compose 将宿主机 ./certs 挂载到 /etc/nginx/certs
    ssl_certificate     ${OPS_TLS_CERT};
    ssl_certificate_key ${OPS_TLS_KEY};

    # OCSP Stapling：仅在使用公网 CA 证书时开启。
    # 内部 CA / 自签证书没有 OCSP responder，开启会在 error.log 刷警告。
    # 需要时取消下面四行注释，并把 resolver 指向内网 DNS。
    # ssl_stapling on;
    # ssl_stapling_verify on;
    # ssl_trusted_certificate ${OPS_TLS_CHAIN};
    # resolver 192.168.60.1 valid=300s ipv6=off;
    # resolver_timeout 5s;

    # ---- 安全响应头 ----------------------------------------------------------
    # 注意：add_header 是「就近替换」不是「叠加」，任何自带 add_header 的
    # location 都必须再 include 一次本片段，否则安全头会静默丢失。
    include /etc/nginx/snippets/security_headers.conf;

    # CI 制品压缩包上报走 /api，放宽上传限制
    client_max_body_size ${OPS_CLIENT_MAX_BODY_SIZE};

    access_log /var/log/nginx/ops-manager.access.log ops_json;
    error_log  /var/log/nginx/ops-manager.error.log warn;

    location = /nginx-health {
        access_log off;
        default_type text/plain;   # 用 default_type 而非 add_header，避免顶掉安全头
        return 200 "ok\n";
    }

    # ---- 后端存活/就绪探针（ops_manager/urls.py 的 healthz / readyz）----------
    # ⚠ 必须显式写出来。不写的话它们落进下面 `location /` 的 SPA 回退，
    # try_files 兜底吐 index.html —— 探针恒得 200 + 一坨 HTML，后端整个挂掉也
    # 照样「健康」。外部拨测与 LB 拿到的是彻头彻尾的假信号。
    #
    # 正则而非 `= /healthz/`：Django 的路由带尾斜杠，但拨测常写成 /healthz，
    # 少了斜杠就又掉回 SPA 回退，且这次的假阳性更隐蔽。两种写法一并接住。
    #
    # 分工：/nginx-health 只证明 nginx 活着（它自己 return 200，不碰后端）；
    # 这两条才穿透到 gunicorn。healthz 不碰数据库，readyz 才探 DB 与 Redis。
    location ~ ^/(healthz|readyz)/?$ {
        access_log off;            # 拨测按秒级打，进 access log 只是噪音

        include /etc/nginx/snippets/proxy_backend.conf;
        proxy_pass http://ops_manager_backend;

        # 探针要快失败：后端卡住时应当立刻报不健康，而不是陪着等
        # ${OPS_PROXY_TIMEOUT}（任务执行那种长请求才需要的超时）。
        proxy_read_timeout 5s;
        proxy_send_timeout 5s;
        proxy_next_upstream off;   # 别把探针的失败重试到别的 upstream 上
    }

    # ---- 前端静态资源（vite 构建产物），SPA 回退 index.html --------------------
    location / {
        root ${OPS_APP_ROOT}/frontend/dist;
        try_files $uri $uri/ /index.html;

        # 带 hash 的构建产物可长缓存；index.html 必须不缓存，否则发版不生效
        location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$ {
            expires 30d;
            include /etc/nginx/snippets/security_headers.conf;
            add_header Cache-Control "public, immutable";
            access_log off;
        }
        location = /index.html {
            include /etc/nginx/snippets/security_headers.conf;
            add_header Cache-Control "no-store";
        }
    }

    # ---- 制品上报：唯一需要关请求缓冲的接口 ------------------------------------
    # CI 推几十 MB 的压缩包。请求缓冲开着的话 nginx 会先把整个包落一遍
    # client_body_temp 再转发，多一轮磁盘读写；这里关掉让它边收边转。
    # 精确匹配（=）优先级高于下面的正则，必须写在前面才生效。
    location = /api/artifacts/report/ {
        access_log /var/log/nginx/ops-manager.api.access.log ops_json;

        include /etc/nginx/snippets/proxy_backend.conf;
        proxy_pass http://ops_manager_backend;

        proxy_request_buffering off;
        proxy_read_timeout ${OPS_PROXY_TIMEOUT};
        proxy_send_timeout ${OPS_PROXY_TIMEOUT};
    }

    # ---- 飞书回调入口（公网，免登录，走签名校验）-------------------------------
    # 必须排在下面的 ^/(api|admin)/ 之前：nginx 的正则 location 按定义顺序匹配，
    # 写在后面就永远命中不到，IP 白名单与限速全部失效（且没有任何报错）。
    #
    # 正则里的 {32} 必须放在引号内 —— nginx 会把裸的 { } 当配置块边界。
    #
    # 三层防护在此处收口：网络层白名单（本 location）+ 应用层白名单（DB 里的
    # ip_whitelist，用 auth_client_ip 解析可信代理链）+ 签名/时间戳/nonce 校验。
    location ~ "^/api/feishu/callback/[0-9a-f]{32}/(event|card)/$" {
        # ⚠ 空白名单 = 拒绝所有回调。填法见该文件内的 TODO
        include /etc/nginx/snippets/feishu_callback_ips.conf;
        deny all;

        limit_req zone=feishu_callback burst=20 nodelay;
        limit_req_status 429;

        access_log /var/log/nginx/ops-manager.api.access.log ops_json;

        include /etc/nginx/snippets/proxy_backend.conf;
        proxy_pass http://ops_manager_backend;

        # 卡片回调要求 3 秒内回包，真正的发卡/执行都是异步的：这里给短超时，
        # 免得一次后端卡顿把 nginx 的连接也一起占着
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
    }

    # ---- 后端 API / Django admin ---------------------------------------------
    location ~ ^/(api|admin)/ {
        access_log /var/log/nginx/ops-manager.api.access.log ops_json;

        include /etc/nginx/snippets/proxy_backend.conf;
        proxy_pass http://ops_manager_backend;

        # 任务执行 / Jenkins 日志同步为长请求
        proxy_read_timeout ${OPS_PROXY_TIMEOUT};
        proxy_send_timeout ${OPS_PROXY_TIMEOUT};

        # 请求缓冲保持开启：nginx 先收完请求体再交给后端，慢客户端上传时
        # 占的是 nginx 的连接而不是 gunicorn 的线程（只有 4×8=32 个）。
    }

    # 机读接口的网络层粗粒度兜底（可选，与后台 per-key IP 白名单叠加）。
    #
    # 分工：per-key 白名单管「哪把 key 能从哪来」，防火墙/nginx 管「这些路径
    # 根本不该从公网被摸到」。前者拦不住扫描流量（校验发生在应用层），后者做不到
    # 按 key 区分（同一台机器上多把 key 长得一样）——两层不可互相替代。
    #
    # 只放行内网与已知出口的场景，取消注释并按实际网段调整；对接公网 Webhook
    # （GitHub/云厂商，源 IP 段大且会变）时不要在这里限制，交给 per-key 白名单。
    # location ~ ^/api/(exec/tasks/[0-9]+/trigger|artifacts/report)/ {
    #     allow 10.0.0.0/8;        # 内网
    #     allow 203.0.113.9;       # CI 出口
    #     deny all;
    #
    #     access_log /var/log/nginx/ops-manager.api.access.log ops_json;
    #     proxy_pass http://ops_manager_backend;
    #     proxy_http_version 1.1;
    #     proxy_set_header Connection "";
    #     proxy_set_header Host              $host;
    #     proxy_set_header X-Real-IP         $remote_addr;
    #     proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    #     proxy_read_timeout  ${OPS_PROXY_TIMEOUT};
    #     proxy_send_timeout  ${OPS_PROXY_TIMEOUT};
    # }

    # 制品文件内部重定向：只能由后端 X-Accel-Redirect 命中（internal），
    # 外部直接访问 /_artifacts/... 返回 404。后端 settings 里的
    # ARTIFACT_XACCEL_PREFIX 必须与这里的前缀一致（默认 /_artifacts/）。
    # 鉴权仍在 Django 的 /api/artifacts/<id>/download/ 做，这里只负责发文件，
    # 几十 MB 的包由 nginx sendfile 直发，不再占着 gunicorn worker。
    location /_artifacts/ {
        internal;
        alias ${OPS_APP_ROOT}/media/artifacts/;  # = ARTIFACT_ROOT
        access_log off;
    }

    # ops-agent WebSocket 接入：daphne（ASGI）监听 8001，仅承载 /ws/；
    # HTTP API 仍走上面的 WSGI（8000），互不影响。
    location /ws/ {
        proxy_pass http://ops_manager_backend_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 与 /api/ 对齐：ASGI 侧 scope['client'] 只会是 nginx 自己的 127.0.0.1，
        # 想在 consumer 里记 agent 真实来源 IP 必须靠这两个头（目前
        # apps/agent_mgr 还没读，先把链路铺好，免得日后加审计再改 nginx）。
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 长连接：读超时需大于 agent 心跳间隔（30s），给足余量
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ---- Django collectstatic 产物（admin / drf-spectacular 等） ---------------
    location /static/ {
        alias ${OPS_APP_ROOT}/staticfiles/;
        expires 7d;
        access_log off;
    }

    # ---- /media/ 一律不对外提供 -------------------------------------------------
    # 曾经这里是 `alias ${OPS_APP_ROOT}/media/`，等于把整个 MEDIA_ROOT 挂上公网。
    # MEDIA_ROOT 下不止制品：
    #   media/artifacts/  —— 直出会绕开 /api/artifacts/<id>/download/ 的签名鉴权
    #   media/acme/       —— ACME_HOME 默认值，里面有 TLS 私钥与 ACME 账号私钥
    # 制品下载只走上面的签名接口（后端吐 X-Accel-Redirect，nginx 从内部的
    # /_artifacts/ 发文件）。不要再把这个 location 改回 alias。
    location /media/ {
        access_log off;
        return 404;
    }
}
