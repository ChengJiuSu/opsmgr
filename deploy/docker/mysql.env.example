# 内置 MySQL 专用环境变量。
#   cp deploy/docker/mysql.env.example deploy/docker/mysql.env
#
# 单独一个文件而不是塞进根 .env：root 密码只有 mysql 容器需要，
# 应用容器（六个）的环境里不该出现它。
# ⚠ 这些变量只在【数据目录为空的首次启动】生效。已经初始化过的数据目录
#   改这里不会改密码，要进容器用 ALTER USER。
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=ops_manager
MYSQL_USER=ops
# 必须与根 .env 的 DB_PASSWORD 一致
MYSQL_PASSWORD=change-me
